<Window x:Class="NordControl.Student.TeacherNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сообщение учителя"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Border Margin="12" Padding="16" CornerRadius="14"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Blue}"
            BorderThickness="2"
            MaxWidth="440" MinWidth="300">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.28" Color="#0F172A"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                    Background="{StaticResource Brush.BlueSoft}" Margin="0,0,14,0" VerticalAlignment="Center">
                <Path Style="{StaticResource Style.IconPath}"
                      Data="{StaticResource Icon.Alert}"
                      Fill="{StaticResource Brush.Blue}"
                      Width="18" Height="18"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Сообщение учителя"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Blue}"
                       VerticalAlignment="Center"/>
            <Button x:Name="CloseIconButton" Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource Style.IconButton}"
                    Width="28" Height="28" MinHeight="28"
                    VerticalAlignment="Top"
                    Click="CloseButton_Click" ToolTip="Закрыть">
                <Path Style="{StaticResource Style.IconPath}"
                      Data="{StaticResource Icon.Close}" Width="12" Height="12"
                      Fill="{StaticResource Brush.TextSecondary}"/>
            </Button>

            <TextBlock x:Name="BodyTextBlock" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                       Text="" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text}"
                       TextWrapping="Wrap" Margin="0,12,0,0"/>

            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                    Content="Закрыть" Width="120" Height="32" MinHeight="32"
                    HorizontalAlignment="Right" Margin="0,14,0,0"
                    Style="{StaticResource Style.SoftAccentButton}"
                    Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>
