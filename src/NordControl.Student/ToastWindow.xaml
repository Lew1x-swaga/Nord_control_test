<Window x:Class="NordControl.Student.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nord Control"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Border x:Name="ToastChrome" Margin="12" Padding="16" CornerRadius="14"
            Background="#111827" BorderBrush="#F43F5E" BorderThickness="2"
            MaxWidth="440" MinWidth="300">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="ToastIconChrome" Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                    Background="#1F2937" Margin="0,0,14,0" VerticalAlignment="Center">
                <Path x:Name="ToastIcon" Style="{StaticResource Style.IconPath}"
                      Data="{StaticResource Icon.Lock}" Fill="#FB7185"
                      Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="ToastTitleTextBlock" Text="Ограничение"
                           FontSize="13" FontWeight="SemiBold" Foreground="#FCA5A5"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="ToastMessageTextBlock" Text="Учитель заблокировал: notepad.exe"
                           FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
