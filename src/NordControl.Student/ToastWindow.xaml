<Window x:Class="NordControl.Student.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nord Control"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Border Margin="12" Padding="14,10" CornerRadius="12"
            Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
            MaxWidth="380" MinWidth="260">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.3" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                    Background="#1E293B" Margin="0,0,12,0" VerticalAlignment="Center">
                <Path x:Name="ToastIcon" Style="{StaticResource Style.IconPath}"
                      Data="{StaticResource Icon.Lock}" Fill="#F43F5E"
                      Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="ToastTitleTextBlock" Text="Ограничение"
                           FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"
                           Margin="0,0,0,2"/>
                <TextBlock x:Name="ToastMessageTextBlock" Text="Учитель заблокировал: notepad.exe"
                           FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
