<Window x:Class="NordControl.Student.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Margin="12" Padding="22,20" CornerRadius="16"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Direction="270" Opacity="0.18" Color="#0F172A"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource Brush.RoseSoft}" Margin="0,0,12,0">
                        <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.Lock}"
                              Fill="{StaticResource Brush.Rose}" Width="18" Height="18"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleTextBlock" Text="Выход" Style="{StaticResource Text.Header}"/>
                        <TextBlock x:Name="CaptionTextBlock" Text="" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="BodyTextBlock" Grid.Row="1"
                       FontSize="13" Foreground="{StaticResource Brush.TextSecondary}"
                       TextWrapping="Wrap" Margin="0,0,0,4"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Отмена" Width="104" Height="36" Margin="0,0,8,0" IsCancel="True"
                        Style="{StaticResource Style.GhostButton}" Click="CancelButton_Click"/>
                <Button x:Name="ConfirmButton" Content="Выйти" Width="120" Height="36" IsDefault="True"
                        Style="{StaticResource Style.DangerButton}" Click="ConfirmButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
