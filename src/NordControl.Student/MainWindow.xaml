<Window x:Class="NordControl.Student.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nord Control — ученик"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Topmost="False"
        ShowInTaskbar="True">
    <Border Margin="10" Padding="12,10" CornerRadius="16"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            MouseLeftButtonDown="Capsule_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.16" Color="#0F172A"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusHalo" Width="14" Height="14" Fill="#94A3B8" Opacity="0.25"/>
                        <Ellipse x:Name="StatusIndicator" Width="8" Height="8" Fill="#94A3B8"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel>
                        <TextBlock x:Name="StatusCaptionTextBlock" Text="Ожидание" Style="{StaticResource Text.Caption}"/>
                        <TextBlock x:Name="StatusHeaderTextBlock" Text="Nord Control — ожидание класса"
                                   Style="{StaticResource Text.Subtitle}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="CollapseButton" Grid.Column="1" Style="{StaticResource Style.IconButton}"
                        Width="28" Height="28" MinHeight="28" Margin="0,0,4,0"
                        Click="CollapseButton_Click" ToolTip="Свернуть плашку" Visibility="Collapsed">
                    <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.Minus}" Width="12" Height="12"/>
                </Button>
                <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource Style.IconButton}" Width="28" Height="28" MinHeight="28"
                        Click="CloseButton_Click" ToolTip="Закрыть">
                    <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.Close}" Width="12" Height="12"/>
                </Button>
            </Grid>

            <StackPanel x:Name="JoinPanel" Grid.Row="1" Margin="0,10,0,0">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LastNameTextBox" Grid.Column="0" Height="32" MinHeight="32" Margin="0,0,4,0"
                             Tag="Фамилия"/>
                    <TextBox x:Name="FirstNameTextBox" Grid.Column="1" Height="32" MinHeight="32" Margin="4,0,0,0"
                             Tag="Имя"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="PIN" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="PinTextBox" Width="116" Height="32" MaxLength="6" FontSize="16" FontWeight="Bold"
                                 FontFamily="Consolas, Cascadia Mono, Segoe UI" HorizontalContentAlignment="Center"
                                 CharacterCasing="Upper" Tag="A2B3C4"/>
                    </StackPanel>
                    <Button x:Name="ConnectButton" Grid.Column="2" Style="{StaticResource Style.AccentButton}"
                            Height="32" Padding="20,0" Click="ConnectButton_Click" Content="Подключиться"/>
                </Grid>
                <Grid Margin="0,0,0,0">
                    <ToggleButton x:Name="AdvancedToggle" Style="{StaticResource Style.LinkToggle}"
                                  Content="Указать IP учителя…" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Checked="AdvancedToggle_Changed" Unchecked="AdvancedToggle_Changed"
                                  ToolTip="PIN всё равно нужен — IP только если класс не находится сам"/>
                </Grid>
                <Border x:Name="AdvancedPanel" Visibility="Collapsed" Margin="0,8,0,0"
                        Background="{StaticResource Brush.SurfaceMuted}" CornerRadius="8" Padding="10,8"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IP учителя" Style="{StaticResource Text.Caption}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="TeacherIpTextBox" Grid.Column="1" Height="28" MinHeight="28"
                                 Tag="192.168.x.x" ToolTip="Не отменяет PIN. Нужен, если автопоиск по Wi‑Fi не сработал"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="ErrorTextBlock" Text="" FontSize="11"
                           Foreground="{StaticResource Brush.Rose}" FontWeight="Medium"
                           Margin="0,8,0,0" TextWrapping="Wrap"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="DiscoveryHintTextBlock" Text="" FontSize="12"
                           Foreground="{StaticResource Brush.TextSecondary}" FontWeight="Medium"
                           Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                           HorizontalAlignment="Left"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
