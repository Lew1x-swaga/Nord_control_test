<Window x:Class="NordControl.Student.ScreenWatcherBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nord Control — надзор"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Border Margin="8" Padding="10,7" CornerRadius="10"
            Background="#0C4A6E" BorderBrush="#38BDF8" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.38" Color="#000000"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.Monitor}"
                      Fill="#7DD3FC" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Width="6" Height="6" Fill="#34D399" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-2,-2"/>
            </Grid>
            <TextBlock Text="Учитель просматривает ваш экран"
                       FontSize="12" FontWeight="SemiBold" Foreground="#F0F9FF"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
