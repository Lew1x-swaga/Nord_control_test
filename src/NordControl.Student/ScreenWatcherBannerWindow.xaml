<Window x:Class="NordControl.Student.ScreenWatcherBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nord Control — надзор"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Border Margin="10" Padding="12,8" CornerRadius="10"
            Background="#0F172A" BorderBrush="#334155" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.32" Color="#000000"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
                <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.Monitor}"
                      Fill="#38BDF8" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Width="6" Height="6" Fill="#10B981" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-1,-1"/>
            </Grid>
            <TextBlock Text="Учитель просматривает ваш экран"
                       FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
