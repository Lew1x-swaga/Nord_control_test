<Window x:Class="NordControl.Student.ScreenWatcherBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nord Control — надзор"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Border Margin="10" Padding="16,12" CornerRadius="12"
            Background="#0C4A6E" BorderBrush="#38BDF8" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center">
                <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.Monitor}"
                      Fill="#7DD3FC" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Width="8" Height="8" Fill="#34D399" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-2,-2"/>
            </Grid>
            <TextBlock Text="Учитель просматривает ваш экран"
                       FontSize="15" FontWeight="Bold" Foreground="#F0F9FF"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
