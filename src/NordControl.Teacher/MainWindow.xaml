<Window x:Class="NordControl.Teacher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NordControl.Teacher"
        mc:Ignorable="d"
        Title="Nord Control — учитель"
        Height="760" Width="1180"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Bg}"
        FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border x:Name="HeaderBar" Grid.Row="0" Style="{StaticResource Style.Card}"
                CornerRadius="0" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource Brush.BlueSoft}" CornerRadius="8" Padding="10,8" Margin="0,0,16,0" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Nord Control" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Blue}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="Класс" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="ClassNameTextBox" Text="Класс" Width="148" Height="28" MinHeight="28"
                                         Tag="Имя класса" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Brush.SurfaceMuted}" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" CornerRadius="10" Padding="14,6,10,6" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="PIN-код" Style="{StaticResource Text.Caption}"/>
                                <TextBlock x:Name="PinTextBlock" Text="K7M2P9" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.Text}" FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button x:Name="CopyPinButton" Style="{StaticResource Style.IconButton}"
                                        Click="CopyPinButton_Click" ToolTip="Копировать PIN в буфер обмена" Margin="0,0,0,4">
                                    <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.Copy}"/>
                                </Button>
                                <Button x:Name="NewPinButton" Style="{StaticResource Style.IconButton}"
                                        Click="NewPinButton_Click" ToolTip="Сгенерировать новый PIN">
                                    <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.Refresh}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="ClassStateBadge" Background="{StaticResource Brush.SurfaceMuted}"
                            CornerRadius="8" Padding="10,6" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ClassStateDot" Width="8" Height="8" Fill="{StaticResource Brush.TextMuted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ClassStateBadgeText" Text="Остановлен" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartClassButton" Style="{StaticResource Style.PrimaryButton}" Click="StartClassButton_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.Launch}" Fill="White" Margin="0,0,8,0"/>
                            <TextBlock Text="Начать класс" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopClassButton" Style="{StaticResource Style.DangerButton}" IsEnabled="False" Click="StopClassButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.Close}" Fill="White" Width="14" Height="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Завершить класс" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Workspace -->
        <Grid x:Name="WorkspaceGrid" Grid.Row="1" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240" MaxWidth="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Students sidebar -->
            <Border Grid.Column="0" Style="{StaticResource Style.Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,2,10">
                        <TextBlock Text="Ученики" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StudentCountTextBlock" Text="Онлайн: 0 / Всего: 0"
                                   Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.Search}"
                              HorizontalAlignment="Left" Margin="10,0,0,0" Panel.ZIndex="1"/>
                        <TextBox x:Name="StudentSearchTextBox" Tag="Поиск по имени или хосту…" Padding="32,0,10,0"
                                 TextChanged="StudentSearchTextBox_TextChanged"/>
                    </Grid>

                    <Border Grid.Row="2" Height="1" Background="{StaticResource Brush.Border}" Margin="0,0,0,8"/>

                    <ListBox x:Name="StudentsListBox" Grid.Row="3"
                             ItemContainerStyle="{StaticResource Style.StudentListItem}"
                             SelectionChanged="StudentsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Ellipse Width="14" Height="14" Opacity="0.22">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{Binding StatusForeground}"/>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Online">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusForeground}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Hostname}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11" FontWeight="Medium"
                                               Foreground="{Binding StatusForeground}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent"/>

            <TabControl Grid.Column="2">
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.Monitor}" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Мониторинг" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <Border x:Name="PlaceholderBorder" Style="{StaticResource Style.Card}" Visibility="Visible">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox Width="88" Height="64" Margin="0,0,0,16">
                                    <Canvas Width="48" Height="36">
                                        <Path Fill="{StaticResource Brush.BorderStrong}"
                                              Data="M2,4 H46 A2,2 0 0 1 48,6 V26 A2,2 0 0 1 46,28 H2 A2,2 0 0 1 0,26 V6 A2,2 0 0 1 2,4 Z M2,6 V24 H46 V6 Z"/>
                                        <Path Fill="{StaticResource Brush.Blue}" Opacity="0.35"
                                              Data="M8,10 H40 V12 H8 Z M8,15 H32 V17 H8 Z M8,20 H24 V22 H8 Z"/>
                                        <Rectangle Canvas.Left="18" Canvas.Top="28" Width="12" Height="3" Fill="{StaticResource Brush.BorderStrong}" RadiusX="1" RadiusY="1"/>
                                        <Rectangle Canvas.Left="12" Canvas.Top="32" Width="24" Height="3" Fill="{StaticResource Brush.Border}" RadiusX="1.5" RadiusY="1.5"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Выберите ученика из списка" Style="{StaticResource Text.Header}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Экран и список процессов выбранного ученика появятся здесь"
                                           Style="{StaticResource Text.Caption}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="StudentDetailGrid" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3*" MinHeight="180"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="2*" MinHeight="120"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource Style.Card}" Padding="12,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Экран ученика" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="SelectedStudentNameTextBlock" Text="" Style="{StaticResource Text.Subtitle}"
                                                   Foreground="{StaticResource Brush.Blue}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Активное приложение" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Border Background="{StaticResource Brush.EmeraldSoft}" CornerRadius="4" Padding="8,3">
                                            <TextBlock x:Name="ActiveAppTextBlock" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="#047857"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Background="{StaticResource Brush.Viewport}" CornerRadius="10" ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="ScreenImage" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="LowQuality"/>
                                    <TextBlock x:Name="WaitingForFrameTextBlock" Text="Ожидание первого кадра…"
                                               FontSize="14" Foreground="{StaticResource Brush.TextMuted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource Brush.ViewportChrome}" CornerRadius="0,0,0,8"
                                            Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Opacity="0.92">
                                        <TextBlock x:Name="StreamMetaTextBlock" Text="— · — FPS" FontSize="11"
                                                   Foreground="#E2E8F0" FontFamily="Consolas, Cascadia Mono, Segoe UI"/>
                                    </Border>
                                    <Button x:Name="StreamFullscreenButton" Style="{StaticResource Style.IconButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                            Background="#1E293B" BorderBrush="#334155"
                                            Click="StreamFullscreenButton_Click" ToolTip="Развернуть на весь экран">
                                        <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.Fullscreen}" Fill="#E2E8F0"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="Transparent"/>

                            <Border Grid.Row="3" Style="{StaticResource Style.Card}" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="2,0,2,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Открытые и свёрнутые окна" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Style="{StaticResource Style.SoftDangerButton}" Click="BlockSelectedProcessButton_Click"
                                                ToolTip="Закрыть это окно и запретить программу до конца урока">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.Lock}" Width="12" Height="12" Fill="#9F1239" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Закрыть и запретить" VerticalAlignment="Center"/>
                                                </StackPanel>
                                        </Button>
                                    </Grid>
                                    <ListView x:Name="ProcessesListView" Grid.Row="1"
                                              ItemContainerStyle="{StaticResource Style.ProcessRow}"
                                              PreviewKeyDown="ProcessesListView_PreviewKeyDown">
                                        <ListView.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Закрыть и запретить до конца урока" Click="BlockProcessMenuItem_Click"/>
                                            </ContextMenu>
                                        </ListView.ContextMenu>
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="EXE" Width="170">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Exe}" VerticalAlignment="Center"/>
                                                                <Border Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                                        Background="{StaticResource Brush.EmeraldSoft}"
                                                                        CornerRadius="3" Padding="6,1" Margin="8,0,0,0">
                                                                    <TextBlock Text="активно" FontSize="10" FontWeight="SemiBold" Foreground="#059669"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding Pid}"/>
                                                <GridViewColumn Header="Заголовок окна" Width="360" DisplayMemberBinding="{Binding Title}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.Apps}" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Программы и ограничения" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" MinHeight="220"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="2*" MinHeight="140"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Style.Card}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Text="Быстрый запуск" Style="{StaticResource Text.Subtitle}"/>
                                        <TextBlock Text="Карточки программ для выбранного ученика или всего класса"
                                                   Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ListBox x:Name="QuickAppsListBox" Grid.Row="1" Margin="0,0,0,8"
                                             ItemContainerStyle="{StaticResource Style.CardListItem}"
                                             PreviewKeyDown="QuickAppsListBox_PreviewKeyDown">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource Brush.BlueSoft}" Margin="0,0,10,0">
                                                        <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.Launch}"
                                                              Fill="{StaticResource Brush.Blue}" Width="14" Height="14"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Brush.Text}"/>
                                                        <TextBlock Text="{Binding Exe}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Grid.Row="2" Margin="0,0,0,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <local:AppSuggestBox x:Name="LaunchAppSuggestBox" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                                             Height="28" Margin="0,0,4,4"
                                                             ToolTip="Начните вводить название или exe — список подскажется"/>
                                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource Style.IconButton}" Margin="0,0,0,4"
                                                Click="AddQuickApp_Click" ToolTip="Добавить в список">
                                            <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.Plus}"/>
                                        </Button>
                                        <TextBox x:Name="NewAppPathTextBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="28" MinHeight="28" Margin="0,0,4,0"
                                                 Tag="Полный путь (необязательно)" ToolTip="Полный путь или цель запуска (необязательно)"/>
                                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Style.IconButton}"
                                                Click="RemoveQuickApp_Click" ToolTip="Удалить выбранную программу">
                                            <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.Close}"/>
                                        </Button>
                                    </Grid>
                                    <UniformGrid Grid.Row="3" Columns="2">
                                        <Button x:Name="LaunchSelectedButton" Style="{StaticResource Style.AccentButton}"
                                                Height="32" Margin="0,0,4,0" Click="LaunchSelectedButton_Click" Content="Запустить у выбранного"/>
                                        <Button x:Name="LaunchAllButton" Style="{StaticResource Style.AccentButton}"
                                                Height="32" Margin="4,0,0,0" Background="#0EA5E9" Click="LaunchAllButton_Click" Content="Запустить у всех"/>
                                    </UniformGrid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Style.Card}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Text="Блокировка приложений (RAM)" Style="{StaticResource Text.Subtitle}"/>
                                        <TextBlock Text="Только в памяти агента · без AppLocker" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ListBox x:Name="BlockedAppsListBox" Grid.Row="1" Margin="0,0,0,8"
                                             ItemContainerStyle="{StaticResource Style.CardListItem}"
                                             PreviewKeyDown="BlockedAppsListBox_PreviewKeyDown">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource Brush.RoseSoft}" Margin="0,0,10,0">
                                                        <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.Lock}"
                                                              Fill="{StaticResource Brush.Rose}" Width="14" Height="14"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#9F1239" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Grid.Row="2" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <local:AppSuggestBox x:Name="BlockAppSuggestBox" Grid.Column="0" Height="28" Margin="0,0,4,0"
                                                             ToolTip="Начните вводить название или exe — список подскажется"/>
                                        <Button Grid.Column="1" Style="{StaticResource Style.IconButton}" Margin="0,0,4,0"
                                                Click="AddBlockedApp_Click" ToolTip="Добавить в блоклист">
                                            <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.Plus}"/>
                                        </Button>
                                        <Button Grid.Column="2" Style="{StaticResource Style.IconButton}"
                                                Click="RemoveBlockedApp_Click" ToolTip="Удалить из блоклиста">
                                            <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.Close}"/>
                                        </Button>
                                    </Grid>
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Height="32" Margin="0,0,3,0" Style="{StaticResource Style.DangerButton}"
                                                MinHeight="32" FontSize="11" Click="ApplyBlockListAll_Click" Content="Применить всем"/>
                                        <Button Grid.Column="1" Height="32" Margin="3,0,3,0" Background="#EA580C" Foreground="White" BorderThickness="0"
                                                FontSize="11" Click="ApplyBlockListSelected_Click" Content="Выбранному"/>
                                        <Button Grid.Column="2" Height="32" Margin="3,0,0,0" Click="ClearBlockListAll_Click" Content="Снять всё"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <Border Grid.Row="2" Style="{StaticResource Style.Card}" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Подсказки ученика" Style="{StaticResource Text.Subtitle}"/>
                                        <TextBlock Text="Только открытые или свёрнутые окна — в запуск или в блоклист"
                                                   Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Style.SoftAccentButton}" Margin="0,0,6,0" Click="AddHintToQuickApps_Click" Content="+ В быстрый запуск"/>
                                        <Button Style="{StaticResource Style.SoftDangerButton}" Click="AddHintToBlockList_Click" Content="+ В блоклист"/>
                                    </StackPanel>
                                </Grid>
                                <ListView x:Name="HintsListView" Grid.Row="1"
                                          PreviewKeyDown="HintsListView_PreviewKeyDown">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Название" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                            <GridViewColumn Header="EXE" Width="130" DisplayMemberBinding="{Binding Exe}"/>
                                            <GridViewColumn Header="Путь запуска" Width="350" DisplayMemberBinding="{Binding LaunchTarget}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Status bar -->
        <Border x:Name="StatusBar" Grid.Row="2" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="18,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock" Grid.Column="0" Text="класс остановлен"
                           FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Nord Control v0.1.0" FontSize="11"
                           Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Fullscreen stream overlay -->
        <Border x:Name="StreamFullscreenOverlay" Grid.Row="0" Grid.RowSpan="3"
                Background="{StaticResource Brush.Viewport}" Visibility="Collapsed" Panel.ZIndex="20">
            <Grid>
                <Image x:Name="FullscreenImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                <Border Background="{StaticResource Brush.ViewportChrome}" CornerRadius="8" Padding="10,6"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16" Opacity="0.92">
                    <TextBlock x:Name="FullscreenMetaTextBlock" Text="— · — FPS" FontSize="12" Foreground="#E2E8F0"
                               FontFamily="Consolas, Cascadia Mono, Segoe UI"/>
                </Border>
                <Button Style="{StaticResource Style.IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="16" Background="#1E293B" BorderBrush="#334155"
                        Click="StreamFullscreenButton_Click" ToolTip="Свернуть (Esc)">
                    <Path Style="{StaticResource Style.IconPath}" Data="{StaticResource Icon.FullscreenExit}" Fill="#E2E8F0"/>
                </Button>
            </Grid>
        </Border>
        <!-- Conflict dialog overlay -->
        <Border x:Name="ConflictDialogOverlay" Grid.Row="0" Grid.RowSpan="3"
                Background="#800F172A" Visibility="Collapsed" Panel.ZIndex="30">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="400" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                    CornerRadius="14" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.25" Color="#0F172A"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="ConflictDialogTitle" Text="Конфликт действия"
                               Style="{StaticResource Text.Subtitle}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ConflictDialogMessage" Text=""
                               FontSize="13" Foreground="{StaticResource Brush.TextSecondary}"
                               TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ConflictCancelButton" Grid.Column="0"
                                Style="{StaticResource Style.IconButton}" Height="34" MinHeight="34"
                                Background="{StaticResource Brush.SurfaceMuted}"
                                Click="ConflictCancelButton_Click" Content="Отмена"/>
                        <Button x:Name="ConflictConfirmButton" Grid.Column="2"
                                Style="{StaticResource Style.AccentButton}" Height="34" MinHeight="34"
                                Click="ConflictConfirmButton_Click" Content="Подтвердить"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
