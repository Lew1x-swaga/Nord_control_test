<Window x:Class="NordControl.Teacher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nord Control — учитель"
        Height="740" Width="1120"
        MinHeight="580" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Control Panel -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Class Name & PIN -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="Имя класса" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="ClassNameTextBox" Text="Класс" Width="140" Height="32" VerticalContentAlignment="Center" Padding="8,0" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="PIN-код" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Border Background="#F1F5F9" CornerRadius="4" Padding="12,2" BorderBrush="#CBD5E1" BorderThickness="1">
                            <TextBlock x:Name="PinTextBlock" Text="1234" FontSize="26" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" FontFamily="Consolas, Segoe UI"/>
                        </Border>
                    </StackPanel>

                    <Button x:Name="NewPinButton" Content="Новый PIN" Height="32" Padding="10,0" Margin="0,16,0,0" Click="NewPinButton_Click" Background="#F8FAFC" BorderBrush="#CBD5E1" Cursor="Hand"/>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="StartClassButton" Content="Начать класс" Height="36" Padding="18,0" Margin="0,0,10,0" FontWeight="SemiBold" FontSize="13" Background="#10B981" Foreground="White" BorderThickness="0" Click="StartClassButton_Click" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="StopClassButton" Content="Завершить класс" Height="36" Padding="18,0" FontWeight="SemiBold" FontSize="13" Background="#EF4444" Foreground="White" BorderThickness="0" IsEnabled="False" Click="StopClassButton_Click" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace (Split: Students | Right Tabbed Workspace) -->
        <Grid Grid.Row="1" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" MaxWidth="400"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Students List -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Список учеников" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="6,4,6,8"/>

                    <ListBox x:Name="StudentsListBox" Grid.Row="1" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="StudentsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                                            <TextBlock Text="{Binding Hostname}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" VerticalAlignment="Center" Padding="6,2" CornerRadius="3" Background="{Binding StatusBackground}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Medium" Foreground="{Binding StatusForeground}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent"/>

            <!-- Right TabControl: Monitoring / Apps & Restrictions -->
            <TabControl Grid.Column="2" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="14,6"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                </TabControl.Resources>

                <!-- Tab 1: Screen & Processes Monitoring -->
                <TabItem Header="Мониторинг">
                    <Grid Margin="0,8,0,0">
                        <!-- Placeholder when no student selected -->
                        <Border x:Name="PlaceholderBorder" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Visibility="Visible">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Выберите ученика из списка" FontSize="18" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text="Экран и список процессов выбранного ученика появятся здесь" FontSize="13" Foreground="#94A3B8" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Student Active View -->
                        <Grid x:Name="StudentDetailGrid" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3*" MinHeight="180"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="2*" MinHeight="120"/>
                            </Grid.RowDefinitions>

                            <!-- Student Header Info -->
                            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Экран ученика: " FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                                        <TextBlock x:Name="SelectedStudentNameTextBlock" Text="" FontSize="13" FontWeight="Bold" Foreground="#0284C7"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Активное приложение: " FontSize="12" Foreground="#64748B"/>
                                        <TextBlock x:Name="ActiveAppTextBlock" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Screen Image Area -->
                            <Border Grid.Row="1" Background="#0F172A" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="ScreenImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock x:Name="WaitingForFrameTextBlock" Text="Ожидание первого кадра…" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="Transparent"/>

                            <!-- Process List Table with ContextMenu -->
                            <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="4,2,4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Запущенные приложения с окнами" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Заблокировать выбранный" FontSize="11" Padding="8,3" Background="#FEE2E2" Foreground="#991B1B" BorderBrush="#FCA5A5" Click="BlockSelectedProcessButton_Click" Cursor="Hand"/>
                                    </Grid>

                                    <ListView x:Name="ProcessesListView" Grid.Row="1" BorderThickness="0" Background="Transparent">
                                        <ListView.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Заблокировать процесс (в RAM)" Click="BlockProcessMenuItem_Click"/>
                                            </ContextMenu>
                                        </ListView.ContextMenu>
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="EXE" Width="140" DisplayMemberBinding="{Binding Exe}"/>
                                                <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding Pid}"/>
                                                <GridViewColumn Header="Заголовок окна" Width="360" DisplayMemberBinding="{Binding Title}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Apps and Policies Management -->
                <TabItem Header="Программы и ограничения">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" MinHeight="220"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="2*" MinHeight="140"/>
                        </Grid.RowDefinitions>

                        <!-- Top Section: Quick Launch (Left) & RAM Block List (Right) -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Quick Launch Panel -->
                            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Быстрый запуск программ" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>

                                    <!-- Quick Apps List -->
                                    <ListBox x:Name="QuickAppsListBox" Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,8" Background="#F8FAFC">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                                                        <TextBlock Text="{Binding Exe}" FontSize="11" Foreground="#64748B"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Add App Inline Inputs -->
                                    <Grid Grid.Row="2" Margin="0,0,0,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="NewAppNameTextBox" Grid.Row="0" Grid.Column="0" Height="26" Margin="0,0,4,4" Padding="4,0" VerticalContentAlignment="Center" ToolTip="Название программы (например, Браузер)" Tag="Название"/>
                                        <TextBox x:Name="NewAppExeTextBox" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,0,4,4" Padding="4,0" VerticalContentAlignment="Center" ToolTip="Имя exe (например, chrome.exe)" Tag="Exe"/>
                                        <Button Grid.Row="0" Grid.Column="2" Content="+" Width="26" Height="26" Margin="0,0,0,4" FontWeight="Bold" Click="AddQuickApp_Click" ToolTip="Добавить в список" Cursor="Hand"/>

                                        <TextBox x:Name="NewAppPathTextBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="26" Margin="0,0,4,0" Padding="4,0" VerticalContentAlignment="Center" ToolTip="Полный путь или цель запуска (необязательно)"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="✕" Width="26" Height="26" Click="RemoveQuickApp_Click" ToolTip="Удалить выбранную программу" Cursor="Hand"/>
                                    </Grid>

                                    <!-- Launch Action Buttons -->
                                    <UniformGrid Grid.Row="3" Columns="2">
                                        <Button x:Name="LaunchSelectedButton" Content="Запустить у выбранного" Height="30" Margin="0,0,4,0" Background="#0284C7" Foreground="White" FontWeight="SemiBold" FontSize="11" BorderThickness="0" Click="LaunchSelectedButton_Click" Cursor="Hand"/>
                                        <Button x:Name="LaunchAllButton" Content="Запустить у всех" Height="30" Margin="4,0,0,0" Background="#0EA5E9" Foreground="White" FontWeight="SemiBold" FontSize="11" BorderThickness="0" Click="LaunchAllButton_Click" Cursor="Hand"/>
                                    </UniformGrid>
                                </Grid>
                            </Border>

                            <!-- RAM Block List Panel -->
                            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Блокировка приложений (RAM)" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>

                                    <!-- Blocked Apps List -->
                                    <ListBox x:Name="BlockedAppsListBox" Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,8" Background="#F8FAFC">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="6,3" Margin="0,1" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="3">
                                                    <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="#991B1B"/>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Add Blocked Exe Input -->
                                    <Grid Grid.Row="2" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewBlockedExeTextBox" Grid.Column="0" Height="26" Margin="0,0,4,0" Padding="4,0" VerticalContentAlignment="Center" ToolTip="Имя exe (например, discord.exe)"/>
                                        <Button Grid.Column="1" Content="+" Width="26" Height="26" Margin="0,0,4,0" FontWeight="Bold" Click="AddBlockedApp_Click" ToolTip="Добавить в блоклист" Cursor="Hand"/>
                                        <Button Grid.Column="2" Content="✕" Width="26" Height="26" Click="RemoveBlockedApp_Click" ToolTip="Удалить из блоклиста" Cursor="Hand"/>
                                    </Grid>

                                    <!-- Block List Action Buttons -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Применить всем" Grid.Column="0" Height="30" Margin="0,0,3,0" Background="#DC2626" Foreground="White" FontWeight="SemiBold" FontSize="11" BorderThickness="0" Click="ApplyBlockListAll_Click" Cursor="Hand"/>
                                        <Button Content="Выбранному" Grid.Column="1" Height="30" Margin="3,0,3,0" Background="#EA580C" Foreground="White" FontWeight="SemiBold" FontSize="11" BorderThickness="0" Click="ApplyBlockListSelected_Click" Cursor="Hand"/>
                                        <Button Content="Снять всё" Grid.Column="2" Height="30" Margin="3,0,0,0" Background="#64748B" Foreground="White" FontWeight="SemiBold" FontSize="11" BorderThickness="0" Click="ClearBlockListAll_Click" Cursor="Hand"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <!-- Bottom Section: Installed Hints of Selected Student -->
                        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Обнаруженное ПО у выбранного ученика (подсказки)" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="+ В быстрый запуск" FontSize="11" Padding="8,3" Margin="0,0,6,0" Background="#E0F2FE" Foreground="#0369A1" BorderBrush="#BAE6FD" Click="AddHintToQuickApps_Click" Cursor="Hand"/>
                                        <Button Content="+ В блоклист" FontSize="11" Padding="8,3" Background="#FEE2E2" Foreground="#991B1B" BorderBrush="#FECACA" Click="AddHintToBlockList_Click" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>

                                <ListView x:Name="HintsListView" Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Название" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                            <GridViewColumn Header="EXE" Width="130" DisplayMemberBinding="{Binding Exe}"/>
                                            <GridViewColumn Header="Путь запуска" Width="350" DisplayMemberBinding="{Binding LaunchTarget}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock" Grid.Column="0" Text="класс остановлен" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Nord Control v0.1.0" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
