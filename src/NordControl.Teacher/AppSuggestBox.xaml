<UserControl x:Class="NordControl.Teacher.AppSuggestBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             LostKeyboardFocus="OnLostKeyboardFocus">
    <Grid>
        <TextBox x:Name="QueryTextBox"
                 Height="28" MinHeight="28"
                 Tag="Найти программу…"
                 TextChanged="QueryTextBox_TextChanged"
                 PreviewKeyDown="QueryTextBox_PreviewKeyDown"
                 GotFocus="QueryTextBox_GotFocus"/>
        <Popup x:Name="SuggestPopup"
               PlacementTarget="{Binding ElementName=QueryTextBox}"
               Placement="Bottom"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    MinWidth="{Binding ActualWidth, ElementName=QueryTextBox}"
                    MaxHeight="260"
                    Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.16" Color="#0F172A"/>
                </Border.Effect>
                <ListBox x:Name="SuggestListBox"
                         BorderThickness="0"
                         Background="Transparent"
                         MaxHeight="252"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="SuggestListBox_PreviewMouseLeftButtonDown"
                         PreviewKeyDown="SuggestListBox_PreviewKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Exe}" FontSize="11"
                                           Foreground="{StaticResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
